DATABASE_URL="mysql://leave:leave@127.0.0.1:3307/leave_management"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3307"
DATABASE_USER="leave"
DATABASE_PASSWORD="leave"
DATABASE_NAME="leave_management"

AUTH_SECRET="change-me"

# App base URL (no trailing slash). Used for Google OAuth redirect URI.
APP_ORIGIN="http://localhost:3002"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI: {APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: only allow this Google Workspace domain (e.g. virgo.hu)
GOOGLE_HOSTED_DOMAIN=""

LDAP_URL="ldap://ldap.example.com:389"
LDAP_BIND_DN="cn=reader,dc=virgo,dc=hu"
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE="dc=virgo,dc=hu"
LDAP_SEARCH_FILTER="(mail={{username}})"
LDAP_USER_DN_TEMPLATE="uid={{username}},ou=people,dc=virgo,dc=hu"
